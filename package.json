{
  "name": "atprice",
  "version": "1.0.0",
  "description": "AtPrice — Local hardware price comparison marketplace for Karnataka",
  "main": "backend/server.js",
  "scripts": {
    "start":   "node --experimental-sqlite backend/server.js",
    "dev":     "node --experimental-sqlite backend/server.js",
    "db:init": "node --experimental-sqlite database/db.js",
    "db:reset": "rm -f database/atprice.sqlite3 && node --experimental-sqlite database/db.js"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "bcryptjs":          "^2.4.3",
    "cors":              "^2.8.5",
    "dotenv":            "^16.4.5",
    "express":           "^4.19.2",
    "express-rate-limit":"^7.3.1",
    "helmet":            "^7.1.0",
    "jsonwebtoken":      "^9.0.2",
    "multer":            "^1.4.5-lts.1"
  }
}
